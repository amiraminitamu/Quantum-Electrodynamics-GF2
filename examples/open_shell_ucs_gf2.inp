! Polar LiH+ doublet with one cavity mode.
%nproc=1
#P UCS-GF2/STO-3G ERI=DF SCF=PK SYMMETRY=C1 UNITS=ANGSTROM

LiH+ unrestricted CS-GF2

1 2
Li 0.0 0.0 0.0
H  0.0 0.0 1.6

se_fit_basis      cc-pvdz-ri
fock_fit_basis    cc-pvdz-ri
beta              10
n_ifreq           32
mid_pt            10
n_ifreq_full      512
n_itime           32
n_poly            12
g_mix             0.5
sigma_mix         0.5
maxiter_gf_diis   120
maxiter_fock_diis 20
mp2               false
mode1 = 0.5, 0.02, 0, 0, 1
