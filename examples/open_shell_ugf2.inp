! Li doublet: fixed N_alpha=2, N_beta=1 UGF2.
%NPROC=1
#P UGF2/STO-3G ERI=STD SCF=PK SYMMETRY=C1 UNITS=ANGSTROM

Li unrestricted GF2

0 2
Li 0.0 0.0 0.0

$GF2
 BETA              = 5
 N_IFREQ           = 32
 MID_PT            = 10
 N_IFREQ_FULL      = 512
 N_ITIME           = 32
 N_POLY            = 12
 G_MIX             = 0.5
 SIGMA_MIX         = 0.5
 MAXITER_GF_DIIS   = 120
 MAXITER_FOCK_DIIS = 20
 MP2               = OFF
$END
