! Li doublet: fixed N_alpha=2, N_beta=1 UGF2.
%nproc=1
#P UGF2/STO-3G ERI=STD SCF=PK SYMMETRY=C1 UNITS=ANGSTROM

Li unrestricted GF2

0 2
Li 0.0 0.0 0.0

beta              5
n_ifreq           32
mid_pt            10
n_ifreq_full      512
n_itime           32
n_poly            12
g_mix             0.5
sigma_mix         0.5
maxiter_gf_diis   120
maxiter_fock_diis 20
mp2               false
