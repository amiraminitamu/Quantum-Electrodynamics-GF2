! H2 / STO-3G electronic GF2 with density fitting. Coordinates are bohr.
%NPROC=1
#P GF2/STO-3G ERI=DF SCF=PK SYMMETRY=C1 UNITS=BOHR

H2 density-fitted electronic GF2

0 1
H   0.0   0.0  -0.6991986661
H   0.0   0.0   0.6991986661

$GF2
 BETA              = 20
 N_IFREQ           = 30
 MID_PT            = 10
 N_IFREQ_FULL      = 200
 N_ITIME           = 30
 N_POLY            = 20
 SE_FIT_BASIS      = cc-pvdz-ri
 FOCK_FIT_BASIS    = cc-pvdz-ri
 MAXITER_GF_DIIS   = 30
 MAXITER_FOCK_DIIS = 8
 N_FIT_PTS         = 1000
 MP2               = OFF
$END
