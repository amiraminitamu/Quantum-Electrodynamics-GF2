! H2 / cc-pVDZ — deterministic Matsubara GF2 (regression geometry)
%NPROC=2
%OUTPUT=examples/h2_results.out
#P GF2/cc-pVDZ ERI=DF SCF=PK SYMMETRY=C1 UNITS=ANGSTROM

H2 cc-pVDZ regression

0 1
H   0.0   0.0   0.0
H   0.0   0.0   0.74

$GF2
 BETA              = 50
 N_IFREQ           = 300
 MID_PT            = 100
 N_IFREQ_FULL      = 10000
 N_ITIME           = 300
 N_POLY            = 50
 SE_FIT_BASIS      = cc-pvdz-ri
 FOCK_FIT_BASIS    = cc-pvdz-ri
 THRESH_ENERGY     = 1.0D-6
 THRESH_FOCK_RMS   = 1.0D-6
 THRESH_NE         = 1.0D-6
 NEWTON            = ON
 MAXITER_NEWTON    = 60
 MAXITER_FOCK_DIIS = 30
 MAXITER_GF_DIIS   = 30
 ! G_MIX = 0.7
 ! SIGMA_MIX = 0.7
 MP2               = ON
$END
