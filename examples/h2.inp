! H2 / cc-pVDZ — deterministic Matsubara GF2 (regression geometry)
%nproc=2
%output=examples/h2_results.out
#P GF2/cc-pVDZ ERI=DF SCF=PK SYMMETRY=C1 UNITS=ANGSTROM

H2 cc-pVDZ regression

0 1
H   0.0   0.0   0.0
H   0.0   0.0   0.74

beta              50
n_ifreq           300
mid_pt            100
n_ifreq_full      10000
n_itime           300
n_poly            50
se_fit_basis      cc-pvdz-ri
fock_fit_basis    cc-pvdz-ri
thresh_energy     1.0e-6
thresh_fock_rms   1.0e-6
thresh_ne         1.0e-6
newton_on         true
maxiter_newton    60
maxiter_fock_diis 30
maxiter_gf_diis   30
! g_mix 0.7
! sigma_mix 0.7
mp2               true
