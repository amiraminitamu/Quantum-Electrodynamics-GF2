! LiH / STO-3G projected LF-GF2. Exact integrals and one cavity mode.
%NPROC=1
#P LF-GF2/STO-3G ERI=STD SCF=PK SYMMETRY=C1 UNITS=ANGSTROM

LiH projected LF-GF2

0 1
Li  0.0   0.0   0.0
H   0.0   0.0   1.5957

$GF2
 BETA              = 20
 N_IFREQ           = 30
 MID_PT            = 10
 N_IFREQ_FULL      = 200
 N_ITIME           = 30
 N_POLY            = 20
 MAXITER_GF_DIIS   = 30
 MAXITER_FOCK_DIIS = 8
 N_FIT_PTS         = 1000
 MP2               = OFF
$END

$CAVITY
 MODE1 = 0.12086, 0.05, 0.0, 0.0, 1.0
$END
