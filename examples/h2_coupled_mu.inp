! Small exact-ERI molecular input. The restricted coupled mu solver is the default.
! Add RESTRICTED_MU_STRATEGY = NESTED below to compare the earlier inner loop.
%NPROC=1
#P GF2/STO-3G ERI=STD SCF=PK SYMMETRY=C1 UNITS=ANGSTROM

H2 exact coupled mu

0 1
H 0.0 0.0 0.0
H 0.0 0.0 0.74

$GF2
 BETA              = 20
 N_IFREQ           = 30
 MID_PT            = 10
 N_IFREQ_FULL      = 200
 N_ITIME           = 30
 N_POLY            = 20
 MAXITER_FOCK_DIIS = 8
 MAXITER_GF_DIIS   = 60
 THRESH_ENERGY     = 1.0D-5
 THRESH_FOCK_RMS   = 1.0D-6
 THRESH_NE         = 1.0D-6
 MP2               = OFF
$END
