! Small exact-ERI molecular input. The restricted coupled mu solver is the default.
! Add restricted_mu_strategy nested below to compare the earlier inner loop.
%nproc=1
#P GF2/STO-3G ERI=STD SCF=PK SYMMETRY=C1 UNITS=ANGSTROM

H2 exact coupled mu

0 1
H 0.0 0.0 0.0
H 0.0 0.0 0.74

beta              20
n_ifreq           30
mid_pt            10
n_ifreq_full      200
n_itime           30
n_poly            20
maxiter_fock_diis 8
maxiter_gf_diis   60
thresh_energy     1.0e-5
thresh_fock_rms   1.0e-6
thresh_ne         1.0e-6
mp2               false
